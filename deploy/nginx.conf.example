# 合并到现有 HTTPS 站点的 server 块中，保留已有证书与 listen 配置。
# 示例假定 Nginx 与 Go 服务在同一主机，且物品系统部署在域名根路径。
# 若在不同容器中，将 127.0.0.1:8080 改为应用容器的内部地址。

# 默认上传上限为 8 MB，额外留出 multipart 请求开销。
client_max_body_size 10m;

location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;

    # 使用 $http_host 保留浏览器访问的域名及非标准端口。
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_read_timeout 90s;
    proxy_send_timeout 90s;
}

# 不要清空/改写 Origin，不要添加 Access-Control-Allow-Origin: *。
# HTTPS 部署请在 config.yaml 中设置 server.secure_cookie: true。
